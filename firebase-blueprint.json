{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "News article item stored in Firestore database",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 50000 },
        "category": { "type": "string", "maxLength": 50 },
        "featuredImage": { "type": "string", "maxLength": 1000000 },
        "imageCaption": { "type": "string", "maxLength": 300 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 20 },
        "isBreaking": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "seoTitle": { "type": "string", "maxLength": 300 },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "focusKeyword": { "type": "string", "maxLength": 100 },
        "canonicalUrl": { "type": "string", "maxLength": 1000 },
        "tags": { "type": "array" },
        "views": { "type": "number" },
        "shares": { "type": "number" },
        "likes": { "type": "number" },
        "readTimeMinutes": { "type": "number" },
        "originalSource": { "type": "string", "maxLength": 300 },
        "originalUrl": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "slug", "content", "category", "status"]
    },
    "VisitorLog": {
      "title": "VisitorLog",
      "description": "Real-time visitor performance event log",
      "type": "object",
      "properties": {
        "articleId": { "type": "string", "maxLength": 100 },
        "articleTitle": { "type": "string", "maxLength": 300 },
        "referrer": { "type": "string", "maxLength": 300 },
        "device": { "type": "string", "maxLength": 50 },
        "browser": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "durationSeconds": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["timestamp", "device"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comments on news articles",
      "type": "object",
      "properties": {
        "articleId": { "type": "string", "maxLength": 100 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "likes": { "type": "number" }
      },
      "required": ["articleId", "userName", "content"]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Header, footer, HTML title, favicon, and admin security settings",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 150 },
        "brandTagline": { "type": "string", "maxLength": 250 },
        "brandLogo": { "type": "string", "maxLength": 50000 },
        "breakingAnnouncement": { "type": "string", "maxLength": 300 },
        "footerAbout": { "type": "string", "maxLength": 1000 },
        "footerAddress": { "type": "string", "maxLength": 300 },
        "footerEmail": { "type": "string", "maxLength": 150 },
        "footerPhone": { "type": "string", "maxLength": 50 },
        "footerCopyright": { "type": "string", "maxLength": 250 },
        "sliderIntervalSeconds": { "type": "number" },
        "htmlTitle": { "type": "string", "maxLength": 200 },
        "htmlFavicon": { "type": "string", "maxLength": 50000 },
        "adminCustomUsername": { "type": "string", "maxLength": 100 },
        "adminCustomPassword": { "type": "string", "maxLength": 100 }
      }
    },
    "SliderSlide": {
      "title": "SliderSlide",
      "description": "Custom photo slides displayed in running news slider showcase",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 250 },
        "subtitle": { "type": "string", "maxLength": 350 },
        "imageUrl": { "type": "string", "maxLength": 50000 },
        "category": { "type": "string", "maxLength": 50 },
        "articleId": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["title", "imageUrl", "category", "order", "isActive"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Koleksi berita portal yang dapat dibaca publik dan dikelola via dashboard admin"
    },
    "/analytics/{logId}": {
      "schema": "VisitorLog",
      "description": "Log aktivitas pengunjung real-time untuk analitik"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Komentar pembaca pada artikel portal"
    },
    "/settings/{settingId}": {
      "schema": "PortalSettings",
      "description": "Konfigurasi permanen header, footer, HTML title, favicon, dan kredensial admin portal"
    },
    "/slider_slides/{slideId}": {
      "schema": "SliderSlide",
      "description": "Daftar slide foto berjalan permanen yang ditampilkan di beranda portal"
    }
  }
}
